# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string (provided by Render)
DATABASE_URL="postgresql://user:password@host:5432/simbasms"

# ─── Redis ───────────────────────────────────────────────────────────────────
# Redis connection string (provided by Render)
REDIS_URL="redis://host:6379"

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_EXPIRES_IN="7d"

# ─── Paystack ────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY="sk_test_..."
PAYSTACK_PUBLIC_KEY="pk_test_..."
PAYSTACK_WEBHOOK_SECRET="..."

# ─── SMS Providers ───────────────────────────────────────────────────────────
VIRTUALSMS_API_KEY="..."
VIRTUALSMS_BASE_URL="https://api.virtualsms.com"
FIVESIM_API_KEY="..."
FIVESIM_BASE_URL="https://5sim.net/v1"

# ─── Crypto Payments (Optional) ─────────────────────────────────────────────
NOWPAYMENTS_API_KEY="..."
NOWPAYMENTS_IPN_SECRET="..."

# ─── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL="https://your-render-app-url.onrender.com"
FRONTEND_URL="https://web-beta-ashen-60.vercel.app"
PORT=4000
